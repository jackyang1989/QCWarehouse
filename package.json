{
  "name": "qcwarehouse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:demo": "node --env-file-if-exists=.env --import tsx scripts/demo.ts",
    "db:regions": "node --env-file-if-exists=.env --import tsx scripts/import-china-regions.mjs",
    "test:brand": "node --import tsx --test tests/brand-consistency.test.mts",
    "test:pkg1-contracts": "node --import tsx --test tests/pkg1-wave1-contracts.test.mts",
    "test:pkg1-wave23": "node --import tsx --test tests/pkg1-wave23-contracts.test.mts",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/brand-consistency.test.mts tests/pkg1-wave1-contracts.test.mts tests/pkg1-wave23-contracts.test.mts tests/pkg1-wave56-email-entities.test.mts tests/pkg1-wave78-staff-rbac.test.mts tests/pkg1-wave9-regions.test.mts tests/pkg1-wave10-warehouses.test.mts tests/pkg1-wave11-workstations-devices.test.mts tests/pkg1-wave12-scheduling-dispatch.test.mts tests/pkg2-wave13-object-storage.test.mts tests/pkg2-wave14-storage-hub.test.mts tests/workflow.test.mts tests/admin-workbench.test.mts tests/round5-payments-ocr.test.mts",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "integrations:check": "node --env-file-if-exists=.env --import tsx scripts/integration-preflight.ts",
    "ops:backup-verify": "node scripts/pre-migration-backup-restore.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@province-city-china/data": "9.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.4.5",
    "openid-client": "6.8.9",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "stripe": "23.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
